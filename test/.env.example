# test/.env — exercised by `secpose up -f test/docker-compose.yml`.
# Placeholders here are resolved by secpose and exposed to docker compose
# via the subprocess environment for ${VAR} interpolation in compose.

# Secret value — secpose will substitute this before docker sees it.
# EXAMPLE_API_KEY=@@mount/example#keyName@@
EXAMPLE_API_KEY=@@<mount>/<path>#<key>@@

# Plain (non-secret) value, just to exercise pass-through.
LOG_LEVEL=info
