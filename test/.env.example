# test/.env.example — exercised by `kvc up -f test/docker-compose.yml`.
# Placeholders here are resolved by kvc and exposed to docker compose
# via the subprocess environment for ${VAR} interpolation in compose.

# Secret value — kvc will substitute this before docker sees it.
# EXAMPLE_API_KEY=@@mount/example#keyName@@
EXAMPLE_API_KEY=@@<mount>/<path>#<key>@@

# Plain (non-secret) value, just to exercise pass-through.
LOG_LEVEL=info
